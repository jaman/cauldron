!IFNDEF PRIV_DIR
PRIV_DIR = priv
!ENDIF

OUT = $(PRIV_DIR:/=\)

all: $(OUT) plane_nif volume_nif blend_nif sector_nif

$(OUT):
	if not exist $(OUT) mkdir $(OUT)

plane_nif volume_nif blend_nif sector_nif:
	-cl /nologo /LD /O2 /fp:strict /I"$(ERTS_INCLUDE_DIR)" c_src\$@.c /Fe:$(OUT)\$@.dll
	if exist $@.obj del /Q $@.obj
	if not exist $(OUT)\$@.dll echo cauldron_2d: c_src\$@.c did not build, its work will be done in Elixir

clean:
	if exist $(OUT)\*.dll del /Q $(OUT)\*.dll
	if exist $(OUT)\*.lib del /Q $(OUT)\*.lib
	if exist $(OUT)\*.exp del /Q $(OUT)\*.exp
