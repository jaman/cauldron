<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
{{permissions}}    <application
        android:label="{{name}}"
        android:extractNativeLibs="true"
        android:enableOnBackInvokedCallback="true"
        android:hasCode="true"{{icon}}>
        <meta-data android:name="cauldron.native_ui" android:value="{{native_ui}}" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="{{id}}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/cauldron_files" />
        </provider>
{{services}}        <activity
            android:name="cauldron.app.CauldronActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="{{orientation}}"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:theme="{{theme}}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
{{links}}        </activity>
    </application>
</manifest>
